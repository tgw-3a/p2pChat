FROM eclipse-temurin:21-jdk AS build
WORKDIR /app

COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle settings.gradle ./
COPY src src

RUN chmod +x gradlew && ./gradlew bootJar -x test --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/build/libs/p2pchat-0.0.1-SNAPSHOT.jar /app/app.jar
COPY entrypoint-java.sh /app/entrypoint-java.sh

RUN chmod +x /app/entrypoint-java.sh

ENTRYPOINT ["/app/entrypoint-java.sh"]
